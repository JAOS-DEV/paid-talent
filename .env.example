# ===========================================
# Paid Talent - Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# Database (Required)
# ===========================================
# PostgreSQL connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/paid_talent"

# ===========================================
# Authentication (Required)
# ===========================================
# NextAuth.js secret - generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Auth URL for callbacks
AUTH_URL="http://localhost:3000"

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# Email Magic Link Authentication (Required for Production)
# ===========================================
# Configure SMTP server for secure magic link sign-in.
# When configured, users receive a sign-in link via email instead of
# entering passwords. Session is only created after clicking the link.
#
# RECOMMENDED: Resend (https://resend.com)
# - Easy setup, generous free tier, built for Next.js
# - Format: smtp://resend:<API_KEY>@smtp.resend.com:465
#
# Resend setup:
#   1. Sign up at resend.com
#   2. Verify your domain (or use test domain)
#   3. Create API key → use in EMAIL_SERVER below
#
EMAIL_SERVER="smtp://resend:re_YOUR_API_KEY@smtp.resend.com:465"
EMAIL_FROM="Paid Talent <noreply@yourdomain.com>"

# Alternative providers:
#   Gmail:    smtp://user:app-password@smtp.gmail.com:587
#   SendGrid: smtp://apikey:SG.xxxxx@smtp.sendgrid.net:587
#   Mailgun:  smtp://postmaster@domain:password@smtp.mailgun.org:587

# ===========================================
# Development-Only Auth Bypass (SECURITY CRITICAL)
# ===========================================
# DANGER: This enables email-only sign-in WITHOUT verification.
# ONLY use for local development with seeded test accounts.
#
# Requirements to enable:
#   1. NODE_ENV must be "development"
#   2. AUTH_DEV_BYPASS must be "true"
#
# NEVER enable in production, staging, or any internet-accessible environment.
# Enabling this allows anyone who knows a registered email to hijack accounts.
#
# AUTH_DEV_BYPASS="true"

# ===========================================
# Admin access
# ===========================================
# Comma-separated allowlist of authenticated admin email addresses.
# Server-side only. Never expose through NEXT_PUBLIC_*.
# Used by /admin UI and /api/admin/* routes via isAdminEmail().
ADMIN_EMAILS="admin@example.com"

# ===========================================
# S3-Compatible Storage (Required for media)
# ===========================================
# AWS S3 or compatible service (MinIO, Cloudflare R2, DigitalOcean Spaces, etc.)
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="true"

# Public marketplace media ONLY (profile photos). This bucket may be publicly
# readable via S3_CDN_URL. It must NEVER store identity documents or liveness
# videos.
S3_BUCKET_NAME="paid-talent-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_CDN_URL=""

# Sensitive identity verification ONLY (ID documents + liveness videos).
# Server-side secrets. NEVER make this bucket public.
# Do NOT enable r2.dev, a public development URL, or a custom public domain
# on paid-talent-private. Access is authenticated S3 API only.
S3_PRIVATE_BUCKET_NAME="paid-talent-private"
S3_PRIVATE_ACCESS_KEY_ID=""
S3_PRIVATE_SECRET_ACCESS_KEY=""

# Optional: Custom endpoint for S3-compatible services
# Cloudflare R2 example:
# S3_REGION="auto"
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="true"

# Required for Cloudflare R2 profile photos (public marketplace media).
# This must be a browser-reachable public media base URL — NOT the R2 S3 API
# endpoint (*.r2.cloudflarestorage.com). The API endpoint is private and is
# only used for authenticated uploads.
#
# Preferred production setup:
#   Cloudflare dashboard → R2 → paid-talent-media → Settings → Public access
#   → Custom Domain (for example media.your-domain.com)
# Then:
# S3_CDN_URL="https://media.your-domain.com"
#
# Never point S3_CDN_URL at paid-talent-private.
# The r2.dev public development URL is acceptable for local testing of the
# PUBLIC media bucket only, not the preferred production architecture.

# Browser profile-photo PUT is cross-origin. The public media bucket MUST
# allow CORS for the Paid Talent origin (PUT + Content-Type + OPTIONS).
# See docs/architecture.md → Media Storage → Bucket CORS.
# Production origin: https://paid-talent.vercel.app
# Local origin: http://localhost:3000

# ===========================================
# Stripe (Required for subscriptions)
# ===========================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_TOP_TALENT_PRICE_ID=""

# Publishable key for client-side
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ===========================================
# Moderation (Optional)
# ===========================================
# Webhook URL for moderation events
# MODERATION_WEBHOOK_URL=""
# MODERATION_WEBHOOK_SECRET=""

# AWS Rekognition for image moderation (optional)
# When not configured, uses stub provider that auto-approves
# AWS_REKOGNITION_ACCESS_KEY_ID=""
# AWS_REKOGNITION_SECRET_ACCESS_KEY=""
# AWS_REKOGNITION_REGION="us-east-1"

# ===========================================
# AdSense (Optional)
# ===========================================
# Set to "true" to enable AdSense
NEXT_PUBLIC_ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# ===========================================
# Application URLs
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
